<Project>
  <PropertyGroup>
    <_MustImportMicrosoftNETSdkWeb Condition="'$(UsingMicrosoftNETSdkWeb)' != 'true'">true</_MustImportMicrosoftNETSdkWeb>

    <CustomBeforeDirectoryBuildProps>$(CustomBeforeDirectoryBuildProps);$(MSBuildThisFileDirectory)../Common/Common.props</CustomBeforeDirectoryBuildProps>
    <BeforeMicrosoftNETSdkTargets>$(BeforeMicrosoftNETSdkTargets);$(MSBuildThisFileDirectory)../Common/Common.targets</BeforeMicrosoftNETSdkTargets>
  </PropertyGroup>

  <Import Sdk="Microsoft.NET.Sdk.Web" Project="Sdk.props" Condition="'$(_MustImportMicrosoftNETSdkWeb)' == 'true'" />
  <Import Project="$(MSBuildThisFileDirectory)../Common/Common.props" Condition="'$(_MustImportMicrosoftNETSdkWeb)' != 'true'" />
</Project>
